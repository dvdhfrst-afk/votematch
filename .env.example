# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Claude (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend
RESEND_API_KEY=your-resend-api-key
# Verified sender address (requires domain verification in Resend)
# RESEND_FROM_EMAIL=Havesay <noreply@example.org>

# Google Civic (validation — uses divisionsByAddress endpoint)
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key

# OpenStates (state legislature voting records)
# Register: https://openstates.org/accounts/signup/
OPENSTATES_API_KEY=your-openstates-api-key

# Congress.gov (federal voting records)
# Register: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=your-congress-api-key

# FEC (federal campaign finance — only used for federal candidates)
# Register: https://api.data.gov/signup/
FEC_API_KEY=your-fec-api-key

# Claude model override (optional — defaults to claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Batch-classify cost ceiling (optional — defaults to 2000).
# Max planned Claude Batch requests (candidates × sub_dimensions × views) before
# the pre-flight cost guard rejects the run. Sized for Phase A (≈950-2090).
# Phase B two-view (≈9,100) requires an explicit bump — this is intentional.
# MAX_BATCH_REQUESTS=2000

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
# Public DSN — exposed to browser, server, edge. Grab from sentry.io →
# Project Settings → Client Keys (DSN) → "Copy DSN".
# Format: https://<public_key>@<org>.ingest.us.sentry.io/<project_id>
# Leave empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token (CI/production only — used by next-build to upload source maps).
# Generate at sentry.io → Settings → Auth Tokens. Scopes needed: project:releases, project:read.
# SENTRY_AUTH_TOKEN=your-auth-token

# Sentry org + project slugs (only needed for source-map upload).
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project

# Local dev: capture Sentry events from local box (off by default).
# Set to 1 to opt in. Leave unset in normal dev.
# SENTRY_LOCAL=0
# NEXT_PUBLIC_SENTRY_LOCAL=0

# Magic Link
MAGIC_LINK_SECRET=your-magic-link-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Havesay

# Matching: per-office issue relevance (feature flag).
# When 'true', each race is scored only on the issues relevant to THAT office
# (level-scope filter intersected with office_types.relevant_dimensions).
# 'false' forces it off. Unset defaults to ON in dev, OFF in production.
# Set to 'true' in production (Vercel) once the relevance data fix is applied.
# See src/lib/matching/office-dims.ts.
MATCHING_RESPECT_OFFICE_DIMS=true

# Ballot guide data provider.
#   mock     : serve the built-in fictional ballot under /guide. Only honored
#              when NODE_ENV=development (npm run dev); needs no database.
#   live     : read real data from Supabase.
#   (unset)  : guide routes show an "in development" notice.
NEXT_PUBLIC_GUIDE_PROVIDER=mock

# Direct Postgres connection string for server-side jobs that use `pg`
# (citation verifier, cost-cap seeder, adapter runner). Required by those jobs.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>

# Optional local paths (all default to folders under the app directory).
# BASELINE_DATASET_PATH=./data/baseline-dataset.json
# SHIM_LOG_DIR=./data/shim-runs
# PM2_LOG_DIR=./pm2-logs
